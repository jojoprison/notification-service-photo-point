# django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=UTC

# db
POSTGRES_DB=notify
POSTGRES_USER=notify
POSTGRES_PASSWORD=notify
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://notify:notify@postgres:5432/notify

# redis
REDIS_URL=redis://redis:6379/0

# providers
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
TELEGRAM_PROVIDER=mock

# real provider creds (optional)
SENDGRID_API_KEY=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELEGRAM_BOT_TOKEN=

# security
API_RATE_LIMIT_PER_MINUTE=120
